# Claude auth: set ONE of these
# Anthropic Console API key
ANTHROPIC_API_KEY=
# or an OAuth token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Airtable (optional: only needed to write results to a base)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Prospects

# Cost controls (optional)
# Model: haiku (cheapest), sonnet (default), opus (most capable, most expensive)
PROSPECT_MODEL=sonnet
# Hard spending cap per prospect, in US dollars (ignored when using a subscription token)
PROSPECT_MAX_BUDGET_USD=0.50
